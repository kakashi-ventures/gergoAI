# .env.example — nomi delle variabili, MAI i valori. Copia in .env.local (web) e compila a mano.
# Vercel: Production e Preview. Development solo in .env.local (in .gitignore).

# Supabase — progetto gergo-pavia (eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=            # pubblica
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # pubblica (publishable/anon)
SUPABASE_SERVICE_ROLE_KEY=           # SEGRETA, solo server (mai NEXT_PUBLIC_)

# xAI / Grok
XAI_API_KEY=                         # SEGRETA, solo server
XAI_VOICE_MODEL=                     # dal file shared/xai-notes.md, non inventarlo
XAI_EVAL_MODEL=                      # modello testo per eval/run.py (condizioni B e C)

# Console
CONSOLE_PASSPHRASE=                  # SEGRETA, cookie httpOnly
BRIDGE_ID=pavia-postazione-1
