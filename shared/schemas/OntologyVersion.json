{
  "$defs": {
    "Place": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "name": {
          "$ref": "#/$defs/PlaceName"
        }
      },
      "required": [
        "name"
      ],
      "title": "Place",
      "type": "object"
    },
    "PlaceName": {
      "enum": [
        "INGRESSO",
        "STAZIONE",
        "USCITA",
        "SCARTI",
        "HOME"
      ],
      "title": "PlaceName",
      "type": "string"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed By"
        },
        "effects": {
          "items": {
            "type": "string"
          },
          "title": "Effects",
          "type": "array"
        },
        "jbi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "nome del file JBI sul controller EC",
          "title": "Jbi"
        },
        "kind": {
          "enum": [
            "primitive",
            "composite",
            "motion",
            "session"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/SkillName"
        },
        "params_schema": {
          "additionalProperties": true,
          "title": "Params Schema",
          "type": "object"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "real_ok": {
          "default": false,
          "title": "Real Ok",
          "type": "boolean"
        },
        "sim_ok": {
          "default": false,
          "title": "Sim Ok",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/SkillStatus",
          "default": "draft"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "Skill",
      "type": "object"
    },
    "SkillName": {
      "enum": [
        "solleva",
        "deposita",
        "porta",
        "applica",
        "home",
        "stop",
        "sposta",
        "piu_piano",
        "piu_veloce"
      ],
      "title": "SkillName",
      "type": "string"
    },
    "SkillStatus": {
      "enum": [
        "draft",
        "confirmed",
        "deprecated"
      ],
      "title": "SkillStatus",
      "type": "string"
    },
    "Tool": {
      "additionalProperties": false,
      "properties": {
        "nome": {
          "minLength": 1,
          "title": "Nome",
          "type": "string"
        },
        "tcp_atteso_mm": {
          "description": "offset x, y, z del TCP dalla flangia in mm",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Tcp Atteso Mm",
          "type": "array"
        }
      },
      "required": [
        "nome",
        "tcp_atteso_mm"
      ],
      "title": "Tool",
      "type": "object"
    },
    "Workspace": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "description": "coordinate_num del frame utente (EC 0–7)",
          "maximum": 7,
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "max_mm": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Max Mm",
          "type": "array"
        },
        "min_mm": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Min Mm",
          "type": "array"
        }
      },
      "required": [
        "frame",
        "min_mm",
        "max_mm"
      ],
      "title": "Workspace",
      "type": "object"
    }
  },
  "$id": "gergo/OntologyVersion.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed At"
    },
    "confirmed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed By"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/Place"
      },
      "title": "Places",
      "type": "array"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/Skill"
      },
      "title": "Skills",
      "type": "array"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "confirmed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/Tool"
      },
      "title": "Tools",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/$defs/Workspace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "version",
    "places",
    "skills"
  ],
  "title": "OntologyVersion",
  "type": "object"
}
