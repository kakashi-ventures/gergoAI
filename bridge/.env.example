# bridge/.env.example — copia in bridge/.env sul laptop del bridge e compila a mano. Mai committare .env.
# Lo usano bridge (python -m bridge.main), audio_guard (python -m safety.audio_guard) e deploy_report.

# Supabase (progetto gergo-pavia)
SUPABASE_URL=https://gppcwepbwrrcsojrwplp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # SEGRETA
BRIDGE_ID=pavia-postazione-1         # bridge.main
GERGO_BRIDGE_ID=pavia-postazione-1   # audio_guard: DEVE coincidere con BRIDGE_ID (default del codice: gergo-1)

# Controller Elite (MOTION_SAFETY.md §1): la serie in sala è CS (sdk/ELITE_NOTES.md)
ELITE_SERIES=CS                      # EC | CS
ELITE_HOST=                          # IP del controller, dallo staff
ELITE_DASHBOARD_PORT=29999           # CS: Dashboard (task -p, play, stop)
ELITE_PRIMARY_PORT=30001             # CS: Primary (script movel, MDH)
ELITE_RTSI_PORT=30004                # CS: RTSI (giunti, posa TCP)
ELITE_PORT=8055                      # solo serie EC: JSON-RPC
ELITE_MODE=dry-run                   # dry-run | read-only | armed

# Arresto vocale e acustico (safety/audio_guard.py): heartbeat locale letto dal bridge
AUDIO_GUARD_HEARTBEAT_FILE=          # file che audio_guard aggiorna ogni 250 ms
GERGO_GUARD_HEARTBEAT=               # stesso percorso, letto dall'adapter Elite
VOSK_MODEL_PATH=                     # modello Vosk italiano piccolo, offline

# Report di deploy (python -m bridge.deploy_report)
VERCEL_DEPLOY_URL=https://gergoai.vercel.app
XAI_API_KEY=                         # SEGRETA, solo per --narrate
XAI_MODEL=                           # modello per --narrate (il codice ha un default: meglio fissarlo qui)
